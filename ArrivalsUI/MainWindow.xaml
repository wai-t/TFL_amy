<Window x:Class="ArrivalsUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArrivalsUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="816" Width="1280">
    <DockPanel>
        <Menu x:Name="menu" DockPanel.Dock="Top">
            <MenuItem Header="Browse Stations" x:Name="BrowseStationArrivals" Click="BrowseStationArrivals_Click"/>
            <MenuItem Header="Line Diagrams" x:Name="LineDiagrams" Click="LineDiagrams_Click"/>
            <MenuItem Header="Map" x:Name="Map" Click="Map_Click"/>

        </Menu>

        <ContentControl x:Name="MainContent" />

    </DockPanel>
</Window>
