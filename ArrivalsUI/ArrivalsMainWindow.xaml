<Window x:Class="ArrivalsUI.ArrivalsMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArrivalsUI"
        mc:Ignorable="d"
        Title="TabbedLines" Height="800" Width="1150">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    Grid.Column="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:LineDiagramBrowser x:Name="lineDiagram" DataContext="{Binding LineDiagramViewModel}">
                        <local:LineDiagramBrowser.Style>
                            <Style TargetType="{x:Type local:LineDiagramBrowser}">
                                <EventSetter Event="StationSelected" Handler="LineDiagramBrowser_StationSelected"/>
                            </Style>
                        </local:LineDiagramBrowser.Style>
                    </local:LineDiagramBrowser>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <local:ArrivalsPanel x:Name="arrivalsPanel" Arrivals="{Binding Arrivals}" Grid.Column="1">
            
            
        </local:ArrivalsPanel>
    </Grid>
</Window>
