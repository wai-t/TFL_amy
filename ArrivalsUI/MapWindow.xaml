<UserControl x:Class="ArrivalsUI.MapWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ArrivalsUI"
             xmlns:map ="clr-namespace:MapControl;assembly=MapControl.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type local:PolylineItem}">
                <map:MapPolyline Locations="{Binding Locations}" Stroke="{Binding Brush}" StrokeThickness="3"/>
            </DataTemplate>

            <Style x:Key="StopPointStyle" TargetType="map:MapItem">
                <Setter Property="Location" Value="{Binding Location}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="map:MapItem">
                            <Canvas>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Disabled"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="hoverTextBlock"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <map:MapPath Stroke="Black" Fill="Black" StrokeThickness="2" IsHitTestVisible="True"
                                            Location="{TemplateBinding Location}"
                                            MouseLeftButtonUp="MapPath_MouseLeftButtonUp"
                                             Panel.ZIndex="1">

                                    <map:MapPath.Data>
                                        <RectangleGeometry Rect="-40,-40,80,80"/>
                                    </map:MapPath.Data>
                                    
                                </map:MapPath>

                                <TextBlock x:Name="hoverTextBlock" Text="{Binding Label}" Foreground="Yellow" Background="Gray" FontSize="16" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Margin="-40,20,0,-20" Opacity="0.0"
                                        Panel.ZIndex="2"/>


                            </Canvas>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="550"/>
        </Grid.ColumnDefinitions>
        <!--Canvas Grid.Column="0">
        </Canvas-->
        <Grid Grid.Column="0">
            <map:Map x:Name="map" Center="51.5074,-0.1278" ZoomLevel="14">
                <map:MapTileLayer>
                    <map:MapTileLayer.TileSource>
                        <map:TileSource UriTemplate="https://tile.openstreetmap.org/{z}/{x}/{y}.png" />
                    </map:MapTileLayer.TileSource>
                </map:MapTileLayer>

                <map:MapItemsControl ItemsSource="{Binding PolylineItems}"/>
                <map:MapItemsControl ItemsSource="{Binding StopPoints}" ItemContainerStyle="{StaticResource StopPointStyle}"/>
            </map:Map>

        </Grid>
        <local:ArrivalsPanel Grid.Column="1"
                             x:Name="arrivals"
                             Arrivals="{Binding Arrivals}">
        </local:ArrivalsPanel>
    </Grid>
</UserControl>
